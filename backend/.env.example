# Fresora backend configuration.
#
# Copy to .env and fill in. NEVER commit the real .env -- it is gitignored.
# Every value here is server-side only and must not be shipped to the app.

# --- General --------------------------------------------------------------
DEBUG=false

# Comma-separated origins allowed to call this API. "*" is fine for local
# development; set your real app/web origins before deploying.
CORS_ORIGINS=*

# --- Vision ---------------------------------------------------------------
# Path to a fine-tuned freshness/food model, plus a labels.txt beside it.
# Leave EMPTY to use stock MobileNetV2 ImageNet weights for identification and
# the documented OpenCV feature formula for the freshness score.
MODEL_PATH=

# Where Keras caches downloaded ImageNet weights (~14 MB, downloaded once).
# Leave empty for the default (~/.keras).
KERAS_HOME=

# Longest edge, in pixels, an uploaded image is resized to before analysis.
MAX_IMAGE_EDGE=1024

# Reject uploads larger than this many bytes (default 12 MB).
MAX_UPLOAD_BYTES=12582912

# --- LLM provider ---------------------------------------------------------
# Powers the AI assistant and generated recipes. With no key set, the assistant
# answers from the built-in food knowledge base and recipes come from the
# built-in matcher -- both clearly labelled in the app. Nothing is faked.
#
# Supported: anthropic | openai | gemini
LLM_PROVIDER=anthropic

# Your provider key. SERVER-SIDE ONLY -- never put this in the Expo app, where
# any EXPO_PUBLIC_* value ships inside the bundle and is readable by anyone
# holding the APK. There is no such thing as a secret in a mobile build.
LLM_API_KEY=

# Model id. Anthropic: claude-sonnet-5 / claude-opus-5 / claude-haiku-4-5.
# OpenAI: gpt-4o-mini. Gemini: gemini-2.5-flash / gemini-2.5-pro.
LLM_MODEL=claude-sonnet-5

# --- Gemini shorthand -----------------------------------------------------
# Setting GEMINI_API_KEY alone is enough: it selects the gemini provider and a
# Gemini model, so there is no half-configured state where the key is set but
# requests still go elsewhere. The generic LLM_* values above win if both are
# present.
#
# Get a key from https://aistudio.google.com/apikey. Google issues more than
# one key format -- "AIza..." and "AQ...." are both valid -- so do not judge a
# key by its prefix. Verify it instead:
#
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=KEY"
#
# A list of models means it works; API_KEY_INVALID means it does not.
#
# In production this belongs in your host's encrypted environment variables
# (Vercel: Settings -> Environment Variables), not in a file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1600

# --- Supabase (server side) ----------------------------------------------
# Only needed if you later move inventory writes behind this API. The mobile
# app talks to Supabase directly with the anon key and row-level security.
#
# The service role key bypasses RLS entirely. It belongs here and nowhere else.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

{
  "expo": {
    "name": "Fresora",
    "slug": "fresora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fresora",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fresora.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Fresora uses your camera to assess the visible condition of your food.",
        "NSPhotoLibraryUsageDescription": "Fresora needs access to your photos so you can analyze an existing picture of your food.",
        "NSPhotoLibraryAddUsageDescription": "Fresora can save the photos you capture of your food."
      }
    },
    "android": {
      "package": "com.fresora.app",
      "adaptiveIcon": {
        "backgroundColor": "#E4EDE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Fresora uses your camera to assess the visible condition of your food."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fresora needs access to your photos so you can analyze an existing picture of your food."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#215031"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FBF8F2",
          "imageWidth": 180
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}

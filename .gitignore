# --- Secrets. Never commit these. ---------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
google-services.json
GoogleService-Info.plist

# --- Node / Expo ---------------------------------------------------------
node_modules/
.expo/
.expo-shared/
dist/
web-build/
*.tsbuildinfo

# Native projects are generated by `expo prebuild`; regenerate, do not commit.
/mobile/android/
/mobile/ios/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Model weights are large binaries; keep them out of git by default.
*.h5
*.onnx
*.tflite
*.keras

# The exception is backend/models/, which is a runtime asset rather than a
# build artefact: the serverless function has no opportunity to download a
# graph at startup, so anything not committed here means identification is
# silently unavailable in production. 14 MB is worth a reproducible deploy.
!/backend/models/
!/backend/models/*.onnx
!/backend/models/*.json
!/backend/models/*.npz
!/backend/models/labels.txt

# --- Editors / OS --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Logs ----------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*

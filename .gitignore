# --- Secrets. Never commit these. ---------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
google-services.json
GoogleService-Info.plist

# --- Node / Expo ---------------------------------------------------------
node_modules/
.expo/
.expo-shared/
dist/
web-build/
*.tsbuildinfo

# Native projects are generated by `expo prebuild`; regenerate, do not commit.
/mobile/android/
/mobile/ios/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Model weights are large binaries; keep them out of git.
*.h5
*.onnx
*.tflite
*.keras
/backend/models/

# --- Editors / OS --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Logs ----------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
